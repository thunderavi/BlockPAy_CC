# BlockPay Mobile Environment Configuration

# Backend API URL:
# - For Web (browser): http://localhost:5000/api
# - For Android Studio Emulator: http://10.0.2.2:5000/api
# - For Physical Device (Expo Go over Wi-Fi): http://<YOUR_LOCAL_IP>:5000/api (e.g. http://192.168.1.10:5000/api)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Standalone UI Demo Mode (set to "true" to test with offline prefilled mock data, or "false" to connect to live Express API)
EXPO_PUBLIC_DEMO_MODE=false
